# syntax=docker/dockerfile:1.7

ARG MDCX_RUNTIME_IMAGE=stainless403/mdcx-builtin-gui-base:mdcx-tpdb-capture-220260923

FROM python:3.13-slim AS build

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_CACHE_DIR=/root/.cache/uv

WORKDIR /src

RUN python -m pip install --no-cache-dir uv

COPY pyproject.toml uv.lock ./
COPY main.py README.md ./
COPY ruff.toml ./
COPY mdcx ./mdcx
COPY resources ./resources
COPY libs ./libs
COPY scripts ./scripts
COPY tests ./tests

RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --locked --group dev --no-install-project

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        binutils libdbus-1-3 libegl1 libfontconfig1 libgl1 libglib2.0-0t64 \
        libx11-6 libx11-xcb1 libxext6 libxkbcommon0 libxkbcommon-x11-0 libxrender1 \
    && rm -rf /var/lib/apt/lists/* \
    && uv run --no-sync ruff check \
        mdcx/config/extend.py \
        mdcx/core/file_crawler.py \
        mdcx/core/scraper.py \
        mdcx/utils/file.py \
        mdcx/utils/video.py \
        mdcx/crawlers/javdb_new.py \
        mdcx/crawlers/theporndb_knowledge.py \
        mdcx/crawlers/javbus.py \
        mdcx/crawlers/theporndb.py \
        mdcx/crawlers/theporndb_match.py \
        tests/test_file_crawler_runtime.py \
        tests/test_file_utils_atomic.py \
        tests/test_media_paths.py \
        tests/crawlers/test_theporndb.py \
        tests/crawlers/test_theporndb_match.py \
        tests/crawlers/test_theporndb_audit.py \
        tests/crawlers/test_scrape_result_routing.py \
        tests/crawlers/test_javdb_new.py \
        tests/crawlers/test_javbus.py \
        tests/crawlers/test_javbus_new.py \
        tests/test_scraper_shared_number.py \
    && uv run --no-sync pytest -q \
        tests/test_file_crawler_runtime.py \
        tests/test_file_utils_atomic.py \
        tests/test_media_paths.py \
        tests/crawlers/test_theporndb_match.py \
        tests/crawlers/test_theporndb.py \
        tests/crawlers/test_theporndb_audit.py \
        tests/crawlers/test_scrape_result_routing.py \
        tests/crawlers/test_javdb_new.py \
        tests/crawlers/test_javbus.py \
        tests/crawlers/test_javbus_new.py \
        tests/test_scraper_shared_number.py \
    && uv run --no-sync python -m PyInstaller --version \
    && uv run --no-sync python scripts/build.py --no-color

FROM ${MDCX_RUNTIME_IMAGE}

COPY --from=build /src/dist/MDCx /app/MDCx
RUN chmod 0755 /app/MDCx

ENV APP_VERSION=220260924-review-fixes
